    "cap:iconos": "capacitor-assets generate --android --iconBackgroundColor \"#960710\" --splashBackgroundColor \"#FAF6EE\"",
    "cap:preparar": "node scripts/preparar-android.mjs"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.2.6",
