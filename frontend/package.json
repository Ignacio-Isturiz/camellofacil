    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "diff": "^9.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "jsdom": "^28.0.0",
