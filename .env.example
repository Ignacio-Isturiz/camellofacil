# Copia este archivo como .env (no se sube a Git) y cambia los valores si quieres.
# Solo para desarrollo local: en producción estas variables viven en el servidor, nunca en el repositorio.
DB_NAME=camellofacil
DB_USER=dev
DB_PASSWORD=cambia-esta-clave-local
DB_URL=jdbc:postgresql://localhost:5433/camellofacil
FRONTEND_URL=http://localhost:4200
# Activa /v3/api-docs solo en desarrollo (para generar el cliente de Angular)
API_DOCS_ENABLED=true
# Puertos locales de Docker (frontend y backend)
FRONTEND_PORT=4200
BACKEND_PORT=8080
# Login con Microsoft (Entra ID). El secreto real nunca va aquí: solo en tu .env local.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
# URL pública del backend (se usa en la redirect URI registrada en Azure)
BACKEND_URL=http://localhost:8080
