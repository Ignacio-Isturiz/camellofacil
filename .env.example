# Copia este archivo como .env (no se sube a Git) y cambia los valores si quieres.
# Solo para desarrollo local: en producción estas variables viven en el servidor, nunca en el repositorio.
DB_NAME=camellofacil
DB_USER=dev
DB_PASSWORD=cambia-esta-clave-local
DB_URL=jdbc:postgresql://localhost:5433/camellofacil
FRONTEND_URL=http://localhost:4200
# Activa /v3/api-docs solo en desarrollo (para generar el cliente de Angular)
API_DOCS_ENABLED=true
